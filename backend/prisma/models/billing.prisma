model Bill {
  id            String   @id @default(cuid())

  patientId     String
  patient       Patient  @relation("PatientBills", fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation("AppointmentBills", fields: [appointmentId], references: [id], onDelete: SetNull)

  billNumber    String   @unique
  invoiceNumber String   @unique

  items         Json
  subtotal      Float
  tax           Float    @default(0)
  discount      Float    @default(0)
  totalAmount   Float

  status        BillStatus @default(UNPAID)
  paymentMethod PaymentMethod?
  paymentDate   DateTime?

  notes         String?

  generatedBy   String
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments      Payment[]

  @@map("bills")
}


model Payment {
  id            String   @id @default(cuid())

  billId        String?
  bill          Bill?    @relation(fields: [billId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation("AppointmentPayments", fields: [appointmentId], references: [id], onDelete: SetNull)

  amount        Float
  method        PaymentMethod
  transactionId String?
  paymentDate   DateTime @default(now())
  notes         String?

  status        PaymentStatus @default(COMPLETED)

  refundedAt    DateTime?
  refundReason  String?

  processedBy   String?
  processor     User? @relation("PaymentProcessor", fields: [processedBy], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("payments")
}