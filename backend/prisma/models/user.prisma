model User{
  id Int @id @default(autoincrement())   
  fullName  String
  email String @unique  
  phone String  @unique
  password String 
  role   Role @default(PATIENT)
  isActive Boolean @default(true)
  creaedAt  DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

enum Role{
  ADMIN
  DOCTOR
  STAFF
  PATIENT
}