model Department {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  headDoctorId String?  @unique

  headDoctor   User?    @relation("DepartmentHead", fields: [headDoctorId], references: [id], onDelete: SetNull)

  hospital     String?
  phone        String?
  email        String?
  location     String?
  isActive     Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctors      Doctor[]

  @@map("departments")
}